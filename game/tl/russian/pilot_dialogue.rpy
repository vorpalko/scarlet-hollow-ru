# unit d:wednesday_hangouts_stella_isaacs_chat_7eb36921
translate russian wednesday_hangouts_stella_isaacs_chat_7eb36921:
    stella "«Та доска, которую оторвали у входа в шахту? Это я. Чтобы снять видео»."

# unit d:wednesday_hangouts_stella_isaacs_chat_1611d7cd
translate russian wednesday_hangouts_stella_isaacs_chat_1611d7cd:
