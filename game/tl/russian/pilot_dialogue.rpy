# unit d:keen_kaneeka_becka_convince_36cf75d1
translate russian keen_kaneeka_becka_convince_36cf75d1:
    tabitha "«Уж {b}{i}тебе-то{/i}{/b} точно не указывать мне, как здесь всем управлять»."

# unit d:keen_kaneeka_becka_convince_87f0303d
translate russian keen_kaneeka_becka_convince_87f0303d:
