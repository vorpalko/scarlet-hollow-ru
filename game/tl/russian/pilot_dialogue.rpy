# unit d:thursday_police_bo_weak_strike_pumpkin_explore_5c8019de
translate russian thursday_police_bo_weak_strike_pumpkin_explore_5c8019de:
    derekson "«Ты, э-э... уверен, что это был не медведь?»"

# unit d:thursday_police_bo_weak_strike_pumpkin_explore_adf2b26d
