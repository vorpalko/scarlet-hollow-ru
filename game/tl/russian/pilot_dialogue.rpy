# unit d:friday_kaneeka_alone_mystical_evil_join_a8e0053c
translate russian friday_kaneeka_alone_mystical_evil_join_a8e0053c:
    sybil "«Бедное дитя... неужели тебе кажется, что обратиться больше не к кому?»"

# unit d:friday_kaneeka_alone_mystical_evil_join_a1f8ee7b
