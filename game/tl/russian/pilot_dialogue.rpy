    opossum "«Какой человек?»"

# unit d:opossum_which_human_general_6a035cef
translate russian opossum_which_human_general_6a035cef:
    p "«Но Перланн умерла. Здесь живёт только один человек»."

# unit d:opossum_which_human_general_b7dc8b51
translate russian opossum_which_human_general_b7dc8b51:
