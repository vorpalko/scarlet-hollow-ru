# unit d:friday_reese_matricide_mines_fbe4bb26
translate russian friday_reese_matricide_mines_fbe4bb26:
    crowd3 "«Эта тварь ещё бегала, а полголовы уже снесло...»"

# unit d:friday_reese_matricide_mines_42d931fe
translate russian friday_reese_matricide_mines_42d931fe:
