# unit d:friday_reese_matricide_mines_3d5aadd7
translate russian friday_reese_matricide_mines_3d5aadd7:
    tabitha "«[player_name]... Это твоих рук дело? Эта тварь явилась по твоей указке... {b}{i}убить{/i}{/b} меня?! Твою кузину?!»"

# unit d:friday_reese_matricide_mines_33a884a9_2
translate russian friday_reese_matricide_mines_33a884a9_2:
