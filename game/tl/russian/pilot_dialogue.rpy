# unit d:thursday_estate_wayne_walk_menu_3f72b7d0
translate russian thursday_estate_wayne_walk_menu_3f72b7d0:
    wayne "«Но обещаю: для этого найдутся время и место»."

# unit d:thursday_estate_wayne_walk_menu_a1b21154
translate russian thursday_estate_wayne_walk_menu_a1b21154:
