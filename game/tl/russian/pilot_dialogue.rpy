# unit d:thursday_tabitha_nice_overheard_join_630bd8cc
translate russian thursday_tabitha_nice_overheard_join_630bd8cc:
    tabitha "«Но он хороший работник. Его не просто так все любят. К нему прислушиваются, ему доверяют. Боюсь, это может дать обратный результат»."

# unit d:thursday_tabitha_nice_overheard_join_87666de4
