translate russian tuesday_mines_depths_tabitha_embark_convo_fa1257e1:
    p "«Стелла, не нарушай так личные границы Табиты»."

# unit d:tuesday_mines_depths_tabitha_embark_convo_6ec1bed9
translate russian tuesday_mines_depths_tabitha_embark_convo_6ec1bed9:
    tabitha "«Не надо за меня заступаться, [player_name]. Всё нормально, пусть Стелла идёт с нами»."

# unit d:tuesday_mines_depths_tabitha_embark_convo_89bbe87f
