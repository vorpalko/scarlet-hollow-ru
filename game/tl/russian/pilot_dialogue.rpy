translate russian tuesday_group2_weird_sub_ca6c04e2:
    rodriguez "«Вроде нет...»"

# unit d:tuesday_group2_weird_sub_2a68d54f
translate russian tuesday_group2_weird_sub_2a68d54f:
    smith "«Там внизу ни хрена не слышно»."

# unit d:tuesday_group2_weird_sub_8fb745a8
translate russian tuesday_group2_weird_sub_8fb745a8:
    rodriguez "«Стук? Я не слышал»."

# unit d:tuesday_group2_weird_sub_7bf80b4f
translate russian tuesday_group2_weird_sub_7bf80b4f:
    smith "«Там внизу ни хрена не слышно: машины работают, люди»."

# unit d:tuesday_group2_weird_sub_ddf65376
translate russian tuesday_group2_weird_sub_ddf65376:
    isaacs "«Мой отец на этих шахтах работал ещё до того, как сюда привезли комбайн непрерывного действия. Ну, ту большую машину»."

# unit d:tuesday_group2_weird_sub_9c34832b
translate russian tuesday_group2_weird_sub_9c34832b:
    isaacs "«Он рассказывал мне истории о каких-то звуках... будто кто-то по стенам колотит...»"

# unit d:tuesday_group2_weird_sub_2bf40f26
translate russian tuesday_group2_weird_sub_2bf40f26:
    rodriguez "«Без обид, Айзекс, но у твоего бати не все дома были»."

# unit d:tuesday_group2_weird_sub_83257c3a
translate russian tuesday_group2_weird_sub_83257c3a:
    smith "«{b}{i}Родригес.{/i}{/b} Он был хорошим человеком»."

# unit d:tuesday_group2_weird_sub_3dcc9860
translate russian tuesday_group2_weird_sub_3dcc9860:
    p "«На эту тему всё, спасибо»."

# unit d:tuesday_group2_weird_sub_2942df7a
translate russian tuesday_group2_weird_sub_2942df7a:
    smith "«Ещё что-нибудь?»"

# unit d:tuesday_group2_weird_sub_f91021a9
translate russian tuesday_group2_weird_sub_f91021a9:
    p "«Неважно»."

# unit d:tuesday_group2_weird_sub_2942df7a_1
translate russian tuesday_group2_weird_sub_2942df7a_1:
    smith "«Ещё что-нибудь?»"

# unit d:tuesday_group2_weird_sub_a7b757b3
translate russian tuesday_group2_weird_sub_a7b757b3:
    p "«Что вы, ребята, думаете о Табите?»"

# unit d:tuesday_group2_weird_sub_8a3d3c0d
translate russian tuesday_group2_weird_sub_8a3d3c0d:
    smith "«С чего это ты задаёшь такой вопрос? Ты на что-то намекаешь?»"

# unit d:tuesday_group2_weird_sub_266b85ce
translate russian tuesday_group2_weird_sub_266b85ce:
    isaacs "«Ужасная женщина»."

# unit d:tuesday_group2_weird_sub_9171d719
translate russian tuesday_group2_weird_sub_9171d719:
    rodriguez "«Ну, ребята, не будем порочить эту прекрасную леди —»"

# unit d:tuesday_group2_weird_sub_e93ff784
translate russian tuesday_group2_weird_sub_e93ff784:
    isaacs "«Если Смит прав, ей за многое надо отвечать»."

# unit d:tuesday_group2_weird_sub_67253d97
translate russian tuesday_group2_weird_sub_67253d97:
    rodriguez "«Ладно, ребята, думаю, нам лучше поостыть и вернуться к работе, пока кто-нибудь не ляпнул чего-нибудь, о чём пожалеет»."

# unit d:tuesday_group2_weird_sub_242df37d
translate russian tuesday_group2_weird_sub_242df37d:
    smith "«Наверное, ты прав»."

# unit d:tuesday_group2_weird_sub_a3da97ae
translate russian tuesday_group2_weird_sub_a3da97ae:
    isaacs "«...»"

# unit d:tuesday_group2_weird_sub_dc77ad84
translate russian tuesday_group2_weird_sub_dc77ad84:
    "{i}Все трое мужчин заметно напрягаются.{/i}"

# unit d:tuesday_group2_weird_sub_e9ffd21b
translate russian tuesday_group2_weird_sub_e9ffd21b:
    smith "«Прекрасная женщина»."

# unit d:tuesday_group2_weird_sub_5f02eb77
translate russian tuesday_group2_weird_sub_5f02eb77:
    rodriguez "«Всегда была хорошей начальницей. Хорошо здесь всем управляет»."

# unit d:tuesday_group2_weird_sub_9c0e5b96
translate russian tuesday_group2_weird_sub_9c0e5b96:
    "(Житейская хватка) {i}Айзекс молчит, глядя в пустоту.{/i}"

# unit d:tuesday_group2_weird_sub_5e03a5ee
translate russian tuesday_group2_weird_sub_5e03a5ee:
    p "«Можете говорить честно. Я не буду стучать»."

# unit d:tuesday_group2_weird_sub_a2532300
translate russian tuesday_group2_weird_sub_a2532300:
    isaacs "«Не доверяй этой женщине»."

# unit d:tuesday_group2_weird_sub_278ad97a
translate russian tuesday_group2_weird_sub_278ad97a:
    smith "«{b}{i}Айзекс!{/i}{/b}»"

# unit d:tuesday_group2_weird_sub_a6576d46
translate russian tuesday_group2_weird_sub_a6576d46:
    smith "«Нам, наверное, скоро стоит вернуться к работе...»"

# unit d:tuesday_group2_weird_sub_f81e2785
translate russian tuesday_group2_weird_sub_f81e2785:
    p "«Вы не знаете парня, который мне встретился в автобусе? Он говорил, что у него тут друзья»."

# unit d:tuesday_group2_weird_sub_b4ba3a02
translate russian tuesday_group2_weird_sub_b4ba3a02:
    kaneeka "«{i}Опять началось...{/i}»"

# unit d:tuesday_group2_weird_sub_3b2b7b9a
translate russian tuesday_group2_weird_sub_3b2b7b9a:
    stella "«{i}Ты потом обязательно расскажи нам про этого парня, [player_name]!{/i}»"

# unit d:tuesday_group2_weird_sub_b3a82de4
translate russian tuesday_group2_weird_sub_b3a82de4:
    rodriguez "«Может быть! А что за парень?»"

# unit d:tuesday_group2_weird_sub_060c7559
translate russian tuesday_group2_weird_sub_060c7559:
    "{i}Вы рассказываете шахтёрам о вчерашней встрече в автобусе.{/i}"

# unit d:tuesday_group2_weird_sub_d35af58e
translate russian tuesday_group2_weird_sub_d35af58e:
    rodriguez "«Такого я, наверное, запомнил бы...»"

# unit d:tuesday_group2_weird_sub_eb8dd225
translate russian tuesday_group2_weird_sub_eb8dd225:
    smith "«Ага, мне он точно не друг. Никогда его не встречал»."

# unit d:tuesday_group2_weird_sub_d2ebaee8
translate russian tuesday_group2_weird_sub_d2ebaee8:
    isaacs "«Не знаю его»."

# unit d:tuesday_group2_weird_sub_d485d693
translate russian tuesday_group2_weird_sub_d485d693:
    stella "{i}«Значит, решено. Твой таинственный незнакомец из автобуса — призрак».{/i}"

# unit d:tuesday_group2_weird_sub_a79355e5
translate russian tuesday_group2_weird_sub_a79355e5:
    kaneeka "{i}«Или он соврал, что знает здешних людей. {b}Или{/b} его друзья немного побыли здесь и уехали из города».{/i}"

# unit d:tuesday_group2_weird_sub_52eb9901
translate russian tuesday_group2_weird_sub_52eb9901:
    stella "{i}«Конечно. Вполне рациональные объяснения. Но и автобусный призрак — тоже. Все теории одинаково рациональны».{/i}"

# unit d:tuesday_group2_weird_sub_40ed3513
translate russian tuesday_group2_weird_sub_40ed3513:
    kaneeka "{i}«Разве ты не скептически относишься к призракам? С чего тут автобусный призрак — рациональное объяснение?»{/i}"

# unit d:tuesday_group2_weird_sub_f9a7836f
translate russian tuesday_group2_weird_sub_f9a7836f:
    kaneeka "{i}«Этот парень ещё и дал тебе тот... арахис, [player_name]. Призраки обычно таким не славятся».{/i}"

# unit d:tuesday_group2_weird_sub_57c7828f
translate russian tuesday_group2_weird_sub_57c7828f:
    stella "{i}«Скептическое отношение к призракам предполагает и непредвзятость ко всем возможным паранормальным встречам!»{/i}"

# unit d:tuesday_group2_weird_sub_27690332
translate russian tuesday_group2_weird_sub_27690332:
    p "«Спасибо за помощь»."

# unit d:tuesday_group2_weird_sub_206a697b
translate russian tuesday_group2_weird_sub_206a697b:
    smith "«Не стоит. Ладно, парни, сворачиваемся. За работу»."

# unit d:tuesday_group2_weird_sub_f91021a9_1
translate russian tuesday_group2_weird_sub_f91021a9_1:
    p "«Неважно»."

# unit d:tuesday_group2_weird_sub_a3f2b887
translate russian tuesday_group2_weird_sub_a3f2b887:
    smith "«Ладно, парни, сворачиваемся. За работу»."

# unit d:tuesday_mines_hub3_99843c14
translate russian tuesday_mines_hub3_99843c14:
    kaneeka "«{i}Может, обсудим, как у нас дела?{/i}»"

# unit d:tuesday_mines_hub3_17b58e4e
translate russian tuesday_mines_hub3_17b58e4e:
    stella "«{i}Сразу предупреждаю: единственная группа, которую я ещё вижу, стоит довольно близко к главной конторе.{/i}»"

# unit d:tuesday_mines_hub3_1b882060
translate russian tuesday_mines_hub3_1b882060:
    stella "«{i}Может, с ними всё-таки стоит поговорить, но если Табита выйдет, не знаю, успею ли я предупредить тебя заблаговременно.{/i}»"

# unit d:tuesday_mines_hub3_convo_db00f767
translate russian tuesday_mines_hub3_convo_db00f767:
    p "«Поговорю ещё с одной, последней группой шахтёров. И не волнуйтесь. Я буду следить за вагончиком Табиты»."

# unit d:tuesday_mines_hub3_convo_a13e5f66
translate russian tuesday_mines_hub3_convo_a13e5f66:
    kaneeka "«{i}Удачи.{/i}»"

# unit d:tuesday_mines_hub3_convo_1aa6debb
translate russian tuesday_mines_hub3_convo_1aa6debb:
    p "«Хочу попробовать поговорить ещё с одной, последней группой шахтёров...»"

# unit d:tuesday_mines_hub3_convo_a13e5f66_1
translate russian tuesday_mines_hub3_convo_a13e5f66_1:
    kaneeka "«{i}Удачи.{/i}»"

# unit d:tuesday_mines_hub3_convo_22e2b87e
translate russian tuesday_mines_hub3_convo_22e2b87e:
    p "«Пойду найду Табиту. Мне нужно поговорить с ней обо всём этом»."

# unit d:tuesday_mines_hub3_convo_d3e38895
translate russian tuesday_mines_hub3_convo_d3e38895:
    stella "«{i}Удачи. Я смотрю в оба.{/i}»"

# unit d:tuesday_mines_hub3_convo_74509913
translate russian tuesday_mines_hub3_convo_74509913:
    p "«Давайте снова встретимся»."

# unit d:tuesday_mines_hub3_convo_ea023b11
translate russian tuesday_mines_hub3_convo_ea023b11:
    stella "«{i}Отлично. Встретимся у фургона.{/i}»"

# unit d:tuesday_mines_group3_219accc1
translate russian tuesday_mines_group3_219accc1:
    tate "«Ходишь тут, вопросы задаёшь, а?»"

# unit d:tuesday_mines_group3_f9f45ee6
translate russian tuesday_mines_group3_f9f45ee6:
    "{i}(Житейская хватка) Стелла не шутила, когда говорила, что эти шахтёры стоят опасно близко к кабинету Табиты. Вы осматриваетесь, отмечая все тени, в которых можно раствориться при первых признаках неприятностей.{/i}"

# unit d:tuesday_mines_group3_180ce16e
translate russian tuesday_mines_group3_180ce16e:
    johnson "«Что-то не похоже, что ты из инспекции...»"

# unit d:tuesday_mines_group3_convo_257aa868
translate russian tuesday_mines_group3_convo_257aa868:
    p "«Наконец-то люди, которые не смеются надо мной из-за того, что меня вчера стошнило на всю закусочную»."

# unit d:tuesday_mines_group3_convo_eea0d67b
translate russian tuesday_mines_group3_convo_eea0d67b:
    kaneeka "«{i}Ладно. Это уже немного печально.{/i}»"

# unit d:tuesday_mines_group3_convo_b3b4c7b9
translate russian tuesday_mines_group3_convo_b3b4c7b9:
    johnson "«А, так это {b}{i}ты{/i}{/b} — Блевота»."

# unit d:tuesday_mines_group3_convo_8ada154d
translate russian tuesday_mines_group3_convo_8ada154d:
    tate "«Я бы особо не переживал. С кем не бывает. Чем помочь?»"

# unit d:tuesday_mines_group3_convo_2eace68b
translate russian tuesday_mines_group3_convo_2eace68b:
    p "«Что вы можете рассказать о Сэме Уэйне?»"

# unit d:tuesday_mines_group3_convo_7cd9c315
translate russian tuesday_mines_group3_convo_7cd9c315:
    johnson "«О-хо-хо, вляпался он в неприятности, да?»"

# unit d:tuesday_mines_group3_convo_d9728097
translate russian tuesday_mines_group3_convo_d9728097:
    tate "«А что, он тебе попадался? Чем этот молодой удалец занимается?»"

# unit d:tuesday_group3_wayne_sub_afa98792
translate russian tuesday_group3_wayne_sub_afa98792:
    p "«А {b}{i}вы{/i}{/b} как думаете, чем он занимается?»"

# unit d:tuesday_group3_wayne_sub_b78450fa
translate russian tuesday_group3_wayne_sub_b78450fa:
    tate "«Знаю только, что кое-кто связался не с тем человеком, и с тех пор в лагере его никто не видел»."

# unit d:tuesday_group3_wayne_sub_8855db6f
translate russian tuesday_group3_wayne_sub_8855db6f:
    johnson "«Я думал, он просто сбежал жить в тот большой особняк со своей красавицей»."

# unit d:tuesday_wayne_reveal_8b444d15
translate russian tuesday_wayne_reveal_8b444d15:
    "{i}Слышно, как Стелла ахает.{/i}"

# unit d:tuesday_wayne_reveal_ef00471b
translate russian tuesday_wayne_reveal_ef00471b:
    tate "«От одной мысли о таком статном молодом парне с этой кислорожей бабой у меня всегда оставался мерзкий осадок»."

# unit d:tuesday_wayne_reveal_912d963b
translate russian tuesday_wayne_reveal_912d963b:
    kaneeka "{i}«О боже, какая {b}гадость{/b}!»{/i}"

# unit d:tuesday_wayne_reveal_4961f3d0
translate russian tuesday_wayne_reveal_4961f3d0:
    johnson "«Да ты бы на колени пал, прояви к тебе богатая женщина хоть малейший интерес. Да и вообще любая женщина»."

# unit d:tuesday_wayne_reveal_9973f63a
translate russian tuesday_wayne_reveal_9973f63a:
    tate "«Ладно, справедливо»."

# unit d:tuesday_wayne_reveal_menu_a782b5f9
translate russian tuesday_wayne_reveal_menu_a782b5f9:
    p "«Погодите, вы о Табите?»"

# unit d:tuesday_wayne_reveal_menu_dc649fad
translate russian tuesday_wayne_reveal_menu_dc649fad:
    tate "«Ага»."

# unit d:tuesday_wayne_reveal_menu_0941daee
translate russian tuesday_wayne_reveal_menu_0941daee:
    stella "«{i}Вот блин. Я догадывалась, к чему они клонят, но странно слышать это вслух.{/i}»"

# unit d:tuesday_wayne_reveal_menu_3018c5e1
translate russian tuesday_wayne_reveal_menu_3018c5e1:
    kaneeka "«{i}Ты в порядке, Стелла?{/i}»"

# unit d:tuesday_wayne_reveal_menu_be3abbe4
translate russian tuesday_wayne_reveal_menu_be3abbe4:
    stella "«{i}Да... Просто я и понятия не имела.{/i}»"

# unit d:tuesday_wayne_reveal_menu_aacd6fa5
translate russian tuesday_wayne_reveal_menu_aacd6fa5:
    p "«Погодите, вы о Перланн?»"

# unit d:tuesday_wayne_reveal_menu_9db8340a
translate russian tuesday_wayne_reveal_menu_9db8340a:
    tate "«Господи, нет, даже Уэйн был разборчив»."

# unit d:tuesday_wayne_reveal_menu_5657a3a4
translate russian tuesday_wayne_reveal_menu_5657a3a4:
    johnson "«Хотя и у старушки Перланн были свои лучшие годы»."

# unit d:tuesday_wayne_reveal_menu_37b16a26
translate russian tuesday_wayne_reveal_menu_37b16a26:
    p "«Чем он занимается? Следит за мной»."

# unit d:tuesday_wayne_reveal_menu_6ae1ef7b
translate russian tuesday_wayne_reveal_menu_6ae1ef7b:
    tate "«А вот {b}{i}это{/i}{/b} уже интересный поворот в его любовной историйке!»"

# unit d:tuesday_wayne_reveal_menu_7daa6ee5
translate russian tuesday_wayne_reveal_menu_7daa6ee5:
    johnson "«Любопытно. Начальница его бросила, или он пытается крутить шашни у неё за спиной?»"

# unit d:tuesday_wayne_reveal_menu_81c8ebbb
translate russian tuesday_wayne_reveal_menu_81c8ebbb:
    p "«По-моему, он разыгрывает слэшер. Только в настоящей жизни. Он мне уже дважды попадался, и его одежда была насквозь пропитана кровью»."

# unit d:tuesday_wayne_reveal_menu_3ca8fb9e
translate russian tuesday_wayne_reveal_menu_3ca8fb9e:
    tate "«Ты про то, как ходят в хоккейной маске и людей убивают? Вот это поворот»."

# unit d:tuesday_wayne_reveal_menu_17277281
translate russian tuesday_wayne_reveal_menu_17277281:
    johnson "«А я-то думал, он просто сбежал жить в тот большой особняк со своей красавицей»."

# unit d:tuesday_wayne_reveal_menu_8b444d15
translate russian tuesday_wayne_reveal_menu_8b444d15:
    "{i}Слышно, как Стелла ахает.{/i}"

# unit d:tuesday_wayne_reveal_menu_ef00471b
translate russian tuesday_wayne_reveal_menu_ef00471b:
    tate "«От одной мысли о таком статном молодом парне с этой кислорожей бабой у меня всегда оставался мерзкий осадок»."

# unit d:tuesday_wayne_reveal_menu_912d963b
translate russian tuesday_wayne_reveal_menu_912d963b:
    kaneeka "{i}«О боже, какая {b}гадость{/b}!»{/i}"

# unit d:tuesday_wayne_reveal_menu_4961f3d0
translate russian tuesday_wayne_reveal_menu_4961f3d0:
    johnson "«Да ты бы на колени пал, прояви к тебе богатая женщина хоть малейший интерес. Да и вообще любая женщина»."

# unit d:tuesday_wayne_reveal_menu_9973f63a
translate russian tuesday_wayne_reveal_menu_9973f63a:
    tate "«Ладно, справедливо»."

# unit d:tuesday_wayne_reveal_menu_844d4173
translate russian tuesday_wayne_reveal_menu_844d4173:
    johnson "«Но тогда, выходит, вопрос... Это она его прогнала, или какой-то ревнивый сукин сын его выжил?»"

# unit d:tuesday_wayne_reveal_menu_19fb9d8f
translate russian tuesday_wayne_reveal_menu_19fb9d8f:
    p "«Мне кажется, его могли убить, и кто-то разгуливает в его окровавленной одежде, выдавая себя за него»."

# unit d:tuesday_wayne_reveal_menu_b75df378
translate russian tuesday_wayne_reveal_menu_b75df378:
    tate "«Ну, если это правда, вот это поворот»."

# unit d:tuesday_wayne_reveal_menu_8fdba5ff
translate russian tuesday_wayne_reveal_menu_8fdba5ff:
    johnson "«Я думал, он просто сбежал жить в тот большой особняк со своей красавицей»."

