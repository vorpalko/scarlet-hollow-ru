# unit d:tuesday_tabitha_morning_duke_cops_bc79bcf5
translate russian tuesday_tabitha_morning_duke_cops_bc79bcf5:
    tabitha "«Они не говорили, что он умер, но сказали, что домой он вчера не вернулся»."

# unit d:tuesday_tabitha_morning_duke_cops_82cc803d
translate russian tuesday_tabitha_morning_duke_cops_82cc803d:
    tabitha "«И у них было немало вопросов о {b}{i}тебе{/i}{/b}, [player_name]»."

# unit d:tuesday_tabitha_morning_duke_cops_467d61a3
translate russian tuesday_tabitha_morning_duke_cops_467d61a3:
