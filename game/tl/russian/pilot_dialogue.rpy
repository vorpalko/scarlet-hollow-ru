translate russian wednesday_solo_tabitha_end_start_5fa85c05:
    tabitha "«И вид у тебя — в гроб краше кладут. Что ты, чёрт возьми, с собой творишь?!»"

# unit d:wednesday_solo_tabitha_end_start_03377d36
translate russian wednesday_solo_tabitha_end_start_03377d36:
