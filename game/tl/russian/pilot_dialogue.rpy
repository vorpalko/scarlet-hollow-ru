    sybil "«Может быть...»"

# unit d:tuesday_sybil_pb_attempt_join_77ad839c
translate russian tuesday_sybil_pb_attempt_join_77ad839c:
    sybil "«По крайней мере, похоже, здесь действует что-то за пределами нашего понимания»."

# unit d:tuesday_sybil_pb_attempt_join_dd39ad58
translate russian tuesday_sybil_pb_attempt_join_dd39ad58:
