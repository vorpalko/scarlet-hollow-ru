# unit d:thursday_estate_wayne_walk_menu_1acf3874
translate russian thursday_estate_wayne_walk_menu_1acf3874:
    "{i}Вы пытаетесь взять его за руку. Он отдёргивает её, едва вы тянетесь вперёд, и ваши пальцы хватают воздух.{/i}"

# unit d:thursday_estate_wayne_walk_menu_2f7e7dc6
translate russian thursday_estate_wayne_walk_menu_2f7e7dc6:
