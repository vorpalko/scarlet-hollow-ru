# unit d:tuesday_mines_depths_tabitha_embark_convo_a00eab92
translate russian tuesday_mines_depths_tabitha_embark_convo_a00eab92:
    stella "«Ну, пока нет, но я веду переговоры с MeatRice™! И неплохо зарабатываю на рекламе и донатах...»"

# unit d:tuesday_depths_tabitha_convo1_3259d8a8
translate russian tuesday_depths_tabitha_convo1_3259d8a8:
