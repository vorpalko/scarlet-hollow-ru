# unit d:wednesday_trial_tabitha_eddie_murderer_925d6bd9
translate russian wednesday_trial_tabitha_eddie_murderer_925d6bd9:
    p "«Если Эдвардин была нашей прабабушкой, откуда ты {b}{i}знаешь{/i}{/b}—»"

# unit d:wednesday_trial_tabitha_eddie_murderer_1b7e08f1
