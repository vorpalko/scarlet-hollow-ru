# unit d:friday_kaneeka_tabitha_anti_sybil_tea_join_b0ab3632
translate russian friday_kaneeka_tabitha_anti_sybil_tea_join_b0ab3632:
    sybil "«А вы с кузиной решили, что лучше всего его убить»."

# unit d:friday_kaneeka_tabitha_anti_sybil_tea_join_0d1997c1
translate russian friday_kaneeka_tabitha_anti_sybil_tea_join_0d1997c1:
