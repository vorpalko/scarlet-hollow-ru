translate russian tuesday_stellas_stayed_bed_final_87ecc63d:
    p "«Дай мне секунду одеться»."

# unit d:tuesday_stellas_stayed_bed_final_e1beca28
translate russian tuesday_stellas_stayed_bed_final_e1beca28:
    tabitha "«Уф. Ладно»."

# unit d:tuesday_stellas_stayed_bed_final_c8e81fd4
translate russian tuesday_stellas_stayed_bed_final_c8e81fd4:
    stella "«Прости, [player_name]!»"

# unit d:tuesday_stellas_stayed_bed_final_9385891c
translate russian tuesday_stellas_stayed_bed_final_9385891c:
    "{i}Вы наскоро одеваетесь и присоединяетесь к Табите и Стелле в гостиной.{/i}"

# unit d:tuesday_stellas_stayed_bed_final_09050568
translate russian tuesday_stellas_stayed_bed_final_09050568:
    "{i}Гретхен оживлённо смотрит на вас и виляет хвостиком.{/i}"

# unit d:tuesday_stellas_stayed_bed_final_6107ea67_2
translate russian tuesday_stellas_stayed_bed_final_6107ea67_2:
