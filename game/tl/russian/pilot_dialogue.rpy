# unit d:tuesday_depths_tabitha_convo1_ab8faaaa
translate russian tuesday_depths_tabitha_convo1_ab8faaaa:
    tabitha "«Ты выдумываешь то, чего нет, Стелла. То, что твой заработок зависит от чужого мнения о тебе, ещё не значит, что {b}{i}мне{/i}{/b} важно, что обо мне думают»."

# unit d:tuesday_depths_tabitha_convo1_e1852683_1
