    stella "«Обязательно, спасибо!»"

# unit d:wednesday_hangouts_stella_biscuits_one_ed391e93_1
translate russian wednesday_hangouts_stella_biscuits_one_ed391e93_1:
    p "«Не люблю яйца»."

# unit d:wednesday_hangouts_stella_biscuits_one_4abf2309_2
translate russian wednesday_hangouts_stella_biscuits_one_4abf2309_2:
    stella "«Мне больше достанется!»"

# unit d:wednesday_hangouts_stella_biscuits_one_5cd702b7_1
translate russian wednesday_hangouts_stella_biscuits_one_5cd702b7_1:
    p "«Фу. Яйца — гадость»."

# unit d:wednesday_hangouts_stella_biscuits_one_4abf2309_3
translate russian wednesday_hangouts_stella_biscuits_one_4abf2309_3:
    stella "«Мне больше достанется!»"

# unit d:wednesday_hangouts_stella_biscuits_one_bac999b8_1
translate russian wednesday_hangouts_stella_biscuits_one_bac999b8_1:
