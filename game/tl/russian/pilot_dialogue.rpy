# unit d:tuesday_sybil_pb_attempt_join_58070568
translate russian tuesday_sybil_pb_attempt_join_58070568:
    sybil "«Ничего страшного, дойдём до Табиты. А если тебе всё ещё так хочется вернуться сюда без компании, обсудишь это с ней»."

# unit d:tuesday_sybil_pb_attempt_join_a06785ea
translate russian tuesday_sybil_pb_attempt_join_a06785ea:
    sybil "«Хотя я бы сама, признаться, возвращаться туда не особенно рвалась...»"

# unit d:tuesday_sybil_pb_attempt_join_273974cf
