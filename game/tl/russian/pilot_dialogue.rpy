# unit d:wednesday_hangout_tabitha_family_other_chat_1e71a4ae
translate russian wednesday_hangout_tabitha_family_other_chat_1e71a4ae:
    tabitha "«Я тебе что, энциклопедия? У нас есть документы и какое-то роскошное генеалогическое древо где-то в поместье, но я же не учила всё это наизусть»."

# unit d:wednesday_hangout_tabitha_family_other_chat_94b33dad
