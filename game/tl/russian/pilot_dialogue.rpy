    stella "«Отлично! Пойдём»."

# unit d:nocops_reception_duke_dies_1bff93e7_5
translate russian nocops_reception_duke_dies_1bff93e7_5:
    gretchen "«Как чудесно, что компанию Стелле и дальше будет составлять не только такая старая собака, как я. Так давно рядом с ней не было друзей!»"

# unit d:nocops_reception_duke_dies_7a5c5fa6_1
