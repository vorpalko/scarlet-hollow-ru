# unit d:tuesday_keen_kaneeka_rosalina_recap_ditchlings_c77c6c1d
translate russian tuesday_keen_kaneeka_rosalina_recap_ditchlings_c77c6c1d:
    stella "«Мне {b}{i}хочется{/i}{/b} сказать, что мы предотвратили ту беду, ради которой они здесь, но, наверное, придётся согласиться. Сегодня вечером никто даже не пострадал. Не представляю, насколько плохо всё может обернуться на самом деле»."

# unit d:tuesday_keen_kaneeka_rosalina_recap_ditchlings_00e56e19
translate russian tuesday_keen_kaneeka_rosalina_recap_ditchlings_00e56e19:
    kaneeka "«Для меня во всём этом по-прежнему как-то слишком много... магии. Если случились две беды, это ещё не значит, что здесь есть закономерность»."

# unit d:tuesday_keen_kaneeka_rosalina_recap_ditchlings_ea8f1f4c
translate russian tuesday_keen_kaneeka_rosalina_recap_ditchlings_ea8f1f4c:
    kaneeka "«...Правда?»"

# unit d:tuesday_keen_kaneeka_rosalina_recap_ditchlings_44d0a32b
translate russian tuesday_keen_kaneeka_rosalina_recap_ditchlings_44d0a32b:
