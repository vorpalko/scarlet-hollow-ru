# unit d:friday_panic_stellamance_action_menu_6cd97952
translate russian friday_panic_stellamance_action_menu_6cd97952:
    stella "«Боже, эти письма от её отца. Мать столько от неё скрывала. Я так злюсь, стоит лишь об этом подумать!»"

# unit d:friday_panic_stellamance_action_menu_e0dd3275_1
translate russian friday_panic_stellamance_action_menu_e0dd3275_1:
