# unit d:tuesday_mines_escape_becka_kaneeka_running_b2e3623b
translate russian tuesday_mines_escape_becka_kaneeka_running_b2e3623b:
    "{i}Вы рвётесь вперёд; боль в горящих мышцах заглушает чистый адреналин.{/i}"

# unit d:tuesday_mines_escape_becka_kaneeka_running_9ee3555c
translate russian tuesday_mines_escape_becka_kaneeka_running_9ee3555c:
    "{i}К своему ужасу, вы видите, как по стенам туннеля ползут трещины.{/i}"

# unit d:tuesday_mines_escape_becka_kaneeka_running_a44132fd
translate russian tuesday_mines_escape_becka_kaneeka_running_a44132fd:
    alexis "«Ну же. Нужно идти {b}{i}быстрее{/i}{/b}»."

# unit d:tuesday_mines_escape_becka_kaneeka_running_9bc49e2b
translate russian tuesday_mines_escape_becka_kaneeka_running_9bc49e2b:
