# unit d:thursday_estate_wayne_walk_menu_edb95a9e
translate russian thursday_estate_wayne_walk_menu_edb95a9e:
    "{i}Вы молча продолжаете путь к поместью.{/i}"

# unit d:thursday_wayne_estate_arrival_40cf3bc6
translate russian thursday_wayne_estate_arrival_40cf3bc6:
