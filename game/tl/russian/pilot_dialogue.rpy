translate russian monday_stella_recap_d9348df2:
    stella "«Завтра с тобой свяжусь»."

# unit d:monday_stella_recap_9c510f8f_2
translate russian monday_stella_recap_9c510f8f_2:
    stella "«Береги себя, ладно?»"

# unit d:monday_stella_recap_b8e2da4b_2
translate russian monday_stella_recap_b8e2da4b_2:
    stella "«Береги себя»."

# unit d:monday_stella_recap_c89e5f37_2
