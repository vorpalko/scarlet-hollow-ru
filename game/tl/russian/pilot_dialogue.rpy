    "{i}Вы молчите.{/i}"

# unit d:wednesday_hangouts_stella_leaving_c4a02b0b
translate russian wednesday_hangouts_stella_leaving_c4a02b0b:
    stella "«Наверное, с собачьего трудно переводить, да? Не бери в голову, пойдём!»"

# unit d:wednesday_hangouts_stella_leaving_f65c99d9
translate russian wednesday_hangouts_stella_leaving_f65c99d9:
    "{i}Незачем рассказывать Стелле, что об этом думает Гретхен.{/i}"

# unit d:wednesday_hangouts_stella_leaving_bb1e17d5_2
translate russian wednesday_hangouts_stella_leaving_bb1e17d5_2:
    stella "«Пойдём?»"

# unit d:wednesday_hangouts_stella_leaving_6dcaead8_1
translate russian wednesday_hangouts_stella_leaving_6dcaead8_1:
    p "«Печенье? Но мы же не готовили печенье»."

# unit d:wednesday_hangouts_stella_leaving_6ed81282_1
translate russian wednesday_hangouts_stella_leaving_6ed81282_1:
    stella "«Ха-ха. Я возьму собачье печенье. Он ведь пёс»."

# unit d:wednesday_hangouts_stella_leaving_0f49a9d0_1
translate russian wednesday_hangouts_stella_leaving_0f49a9d0_1:
    stella "«...»"

# unit d:wednesday_hangouts_stella_leaving_d044c9a5_1
translate russian wednesday_hangouts_stella_leaving_d044c9a5_1:
    stella "«Не бери в голову!»"

# unit d:wednesday_hangouts_stella_leaving_bb1e17d5_3
translate russian wednesday_hangouts_stella_leaving_bb1e17d5_3:
    stella "«Пойдём?»"

# unit d:wednesday_hangouts_stella_leaving_f8ad278b
translate russian wednesday_hangouts_stella_leaving_f8ad278b:
    "{i}Вы решаете оставить эту тему.{/i}"

# unit d:wednesday_hangouts_stella_leaving_bb1e17d5_4
translate russian wednesday_hangouts_stella_leaving_bb1e17d5_4:
    stella "«Пойдём?»"

# unit d:wednesday_hangouts_stella_leaving_bb1e17d5_5
