# unit d:wednesday_haunt_tabitha_room2_questioning_join_ea2c1f3f_1
translate russian wednesday_haunt_tabitha_room2_questioning_join_ea2c1f3f_1:
    tabitha "«Хочешь записывать — пожалуйста. Но мне эта загадочка неинтересна»."

# unit d:wednesday_haunt_tabitha_room2_questioning_join_479ed898
