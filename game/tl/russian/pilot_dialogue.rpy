# unit d:wednesday_hangouts_stella_isaacs_chat_8e041de9
translate russian wednesday_hangouts_stella_isaacs_chat_8e041de9:
    stella "«Да. Я рада, что они борются за себя. Просто мне немного трудно не думать и о том, через что проходит Тэбби»."

# unit d:wednesday_hangouts_stella_isaacs_chat_8a0d7375
translate russian wednesday_hangouts_stella_isaacs_chat_8a0d7375:
