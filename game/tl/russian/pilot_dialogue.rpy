# unit d:monday_ride_both_survive_interjection_0d027b72
translate russian monday_ride_both_survive_interjection_0d027b72:
    "{i}Шесть пропущенных звонков от Табиты...{/i}"

# unit d:monday_ride_both_survive_interjection_d66e1293
translate russian monday_ride_both_survive_interjection_d66e1293:
    "{i}И тринадцать сообщений.{/i}"

# unit d:tabitha_text_both_alive_1d3ecaf4
translate russian tabitha_text_both_alive_1d3ecaf4:
