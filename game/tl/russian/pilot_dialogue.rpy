# unit d:tuesday_mines_escape_becka_tabitha_running_f3ecb049_1
translate russian tuesday_mines_escape_becka_tabitha_running_f3ecb049_1:
    becka "«Ладно... ладно»."

# unit d:tuesday_mines_escape_becka_tabitha_running_e7da590b
