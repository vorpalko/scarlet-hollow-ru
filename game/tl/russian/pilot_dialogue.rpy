# unit d:tuesday_tabitha_present_rosa_hurt_4_join_be299249
translate russian tuesday_tabitha_present_rosa_hurt_4_join_be299249:
    p "«Я и без помощи дойду до машины»."

# unit d:tuesday_tabitha_present_rosa_hurt_4_join_185a1533
translate russian tuesday_tabitha_present_rosa_hurt_4_join_185a1533:
    p "«Ты меня похищаешь?»"

# unit d:tuesday_tabitha_present_rosa_hurt_4_join_032a63c5
