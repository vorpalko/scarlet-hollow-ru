# unit d:friday_stella_start_hesitance_menu_b6249f4c
translate russian friday_stella_start_hesitance_menu_b6249f4c:
    p "«Мне правда не хочется, Стелла»."

# unit d:friday_stella_start_hesitance_menu_84cbe0fa
