# unit d:wednesday_tabitha_book_pearlanne_confession_234dee62
translate russian wednesday_tabitha_book_pearlanne_confession_234dee62:
    "{i}Вы молчите.{/i}"

# unit d:wednesday_tabitha_book_pearlanne_confession_f32d65d6
translate russian wednesday_tabitha_book_pearlanne_confession_f32d65d6:
