# unit d:thursday_library_clean_kaneeka_break_join_234dee62
translate russian thursday_library_clean_kaneeka_break_join_234dee62:
    "{i}Вы молчите.{/i}"

# unit d:thursday_library_clean_kaneeka_break_join_db8c405f
translate russian thursday_library_clean_kaneeka_break_join_db8c405f:
    kaneeka "«Ладно, нам, наверное, пора снова искать Стеллу. Держи нас в курсе, хорошо?»"

# unit d:thursday_library_clean_kaneeka_break_join_eb110ac3_4
