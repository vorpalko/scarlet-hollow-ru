# unit d:tuesday_library_planning_89f74fa3
translate russian tuesday_library_planning_89f74fa3:
    p "«Ясно. Я здесь для красоты, а вы строите планы. У всех свои роли»."

# unit d:tuesday_library_planning_5e17cf3d
translate russian tuesday_library_planning_5e17cf3d:
    kaneeka "«С тобой забавно»."

# unit d:tuesday_library_planning_8b5ba06b
translate russian tuesday_library_planning_8b5ba06b:
    stella "«Рада, что ты с нами!»"

# unit d:tuesday_library_planning_a01b5c68_2
translate russian tuesday_library_planning_a01b5c68_2:
    kaneeka "«Проблема только в Табите... Она вряд ли обрадуется, увидев, как мы вынюхиваем что-то у шахт»."

