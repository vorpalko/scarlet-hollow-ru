# unit d:tuesday_mines_escape_becka_tabitha_running_5f23249a
translate russian tuesday_mines_escape_becka_tabitha_running_5f23249a:
    becka "«{b}{i}Ясно же{/i}{/b}, что не в порядке, идиотка!»"

# unit d:tuesday_mines_escape_becka_tabitha_running_84d43cb1
translate russian tuesday_mines_escape_becka_tabitha_running_84d43cb1:
    alexis "«{b}{i}Заткнись,{/i}{/b} Бекка! Это вообще {b}{i}ты{/i}{/b} придумала сюда спуститься! Это {b}{i}твоя вина{/i}{/b}»."

# unit d:tuesday_mines_escape_becka_tabitha_running_75f230ed
translate russian tuesday_mines_escape_becka_tabitha_running_75f230ed:
    tabitha "«Вот дерьмо. Вот дерьмо. Почему?! Почему это должно было случиться?!»"

# unit d:tuesday_mines_escape_becka_tabitha_running_9ba803c1
translate russian tuesday_mines_escape_becka_tabitha_running_9ba803c1:
    tabitha "«Ладно. По крайней мере, стук прекратился. Всем оставаться {b}{i}ИМЕННО{/i}{/b} там, где стоите. Я сделаю несколько звонков»."

# unit d:tuesday_mines_escape_becka_tabitha_running_9dc39ccb
translate russian tuesday_mines_escape_becka_tabitha_running_9dc39ccb:
    rosalina "«{b}{i}Кхе...{/i}{/b}»"

# unit d:tuesday_mines_escape_becka_tabitha_running_cd4ee0cc
translate russian tuesday_mines_escape_becka_tabitha_running_cd4ee0cc:
    rosalina "«Очень... больно...»"

# unit d:tuesday_mines_escape_becka_tabitha_running_0f5c3340
translate russian tuesday_mines_escape_becka_tabitha_running_0f5c3340:
