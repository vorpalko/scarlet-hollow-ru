# unit d:friday_stellamance_reconcile_dad_share_late_join_a7a06ca0
translate russian friday_stellamance_reconcile_dad_share_late_join_a7a06ca0:
    tabitha "«Это не значит, что Перланн была насчёт него неправа... Он всё равно ушёл»."

# unit d:friday_stellamance_reconcile_dad_share_late_join_23c68303
translate russian friday_stellamance_reconcile_dad_share_late_join_23c68303:
    stella "«Но... она прятала их от тебя»."

# unit d:friday_stellamance_reconcile_dad_share_late_join_2a55dd39
translate russian friday_stellamance_reconcile_dad_share_late_join_2a55dd39:
    stella "«Может, начала бабушка Эдди, но твоя мама продолжила. Она тебе врала — по крайней мере, о его чувствах. Не думаешь... что она могла врать и о чём-то ещё?»"

# unit d:friday_stellamance_reconcile_dad_share_late_join_fed6a7fb
translate russian friday_stellamance_reconcile_dad_share_late_join_fed6a7fb:
    stella "«Чтобы ты наверняка делала то, чего она хотела?»"

# unit d:friday_stellamance_reconcile_dad_share_late_join_42086068
translate russian friday_stellamance_reconcile_dad_share_late_join_42086068:
