# unit d:tuesday_sybil_pb_attempt_join_a28c6822
translate russian tuesday_sybil_pb_attempt_join_a28c6822:
    sybil "«Уверена, за эту неделю у тебя ещё будет вдоволь приятных часов в старом особняке. Хотя после того, что мы только что видели, не понимаю, зачем тебе это»."

# unit d:tuesday_sybil_pb_attempt_join_41b6d548
