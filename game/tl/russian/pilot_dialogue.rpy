# unit d:wednesday_tabitha_left_outside_housing_f856cb61
translate russian wednesday_tabitha_left_outside_housing_f856cb61:
    kaneeka "«Ты точно не можешь принять предложение Алексис?»"

# unit d:wednesday_tabitha_maxwell_offer_d058e404
translate russian wednesday_tabitha_maxwell_offer_d058e404:
