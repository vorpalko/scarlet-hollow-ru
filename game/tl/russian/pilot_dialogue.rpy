# unit d:wednesday_trial_tabitha_eddie_murderer_a14f5df9
translate russian wednesday_trial_tabitha_eddie_murderer_a14f5df9:
    stella "«Вы раскаиваетесь?»"

# unit d:wednesday_trial_tabitha_eddie_murderer_90078044
translate russian wednesday_trial_tabitha_eddie_murderer_90078044:
    kaneeka "«Вы раскаиваетесь в своих преступлениях?»"

# unit d:wednesday_trial_tabitha_eddie_murderer_8148fe9a
translate russian wednesday_trial_tabitha_eddie_murderer_8148fe9a:
    p "«Их имена снова обычные. Должно быть, они больше не играют роли»."

# unit d:wednesday_trial_tabitha_eddie_murderer_3b02f2eb
translate russian wednesday_trial_tabitha_eddie_murderer_3b02f2eb:
    tabitha "«Может, оно слабеет»."

# unit d:wednesday_trial_tabitha_eddie_murderer_cee0c69c
translate russian wednesday_trial_tabitha_eddie_murderer_cee0c69c:
    p "«Ты... с нами разговариваешь?»"

# unit d:wednesday_trial_tabitha_eddie_murderer_87f9b342
