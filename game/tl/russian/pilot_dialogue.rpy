# unit d:tuesday_mines_escape_becka_tabitha_running_f3ecb049_2
translate russian tuesday_mines_escape_becka_tabitha_running_f3ecb049_2:
    becka "«Ладно... ладно»."

# unit d:tuesday_mines_escape_becka_tabitha_running_a7894a40
