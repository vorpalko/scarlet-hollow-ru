# unit d:friday_kaneeka_alone_mystical_evil_join_4acba2ab
translate russian friday_kaneeka_alone_mystical_evil_join_4acba2ab:
    sybil "«Это самое близкое к правде, что я могу сказать. Да»."

# unit d:friday_kaneeka_alone_mystical_evil_join_bd02bbdf
translate russian friday_kaneeka_alone_mystical_evil_join_bd02bbdf:
