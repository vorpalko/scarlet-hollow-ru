# unit d:wednesday_tabitha_becka_mom_rosalina_legal2_65385e3d
translate russian wednesday_tabitha_becka_mom_rosalina_legal2_65385e3d:
    beckamom "«{b}{i}Что{/i}{/b}, простите? Моя дочь заживо погребена. Или {b}{i}хуже{/i}{/b}. Как вы смеете так говорить о моей Бекке!»"

# unit d:wednesday_tabitha_becka_mom_rosalina_legal2_bae281e3
translate russian wednesday_tabitha_becka_mom_rosalina_legal2_bae281e3:
