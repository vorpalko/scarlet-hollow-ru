translate russian tuesday_mines_depths_tabitha_keen_embark_convo_fa1257e1:
    p "«Стелла, не нарушай так личные границы Табиты»."

# unit d:tuesday_mines_depths_tabitha_keen_embark_convo_6ec1bed9
