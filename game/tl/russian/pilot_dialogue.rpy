    dustin "«Дастин»."

# unit d:general_opossum_convo_6600ea74
translate russian general_opossum_convo_6600ea74:
    p "«Что ты делаешь в моём комоде?»"

# unit d:general_opossum_convo_4d832beb
translate russian general_opossum_convo_4d832beb:
    opossum "«Тепло, темно»."

# unit d:general_opossum_convo_dc3e0d66
