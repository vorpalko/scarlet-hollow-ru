# unit d:tuesday_keen_kaneeka_rosalina_recap_fa48a58c
translate russian tuesday_keen_kaneeka_rosalina_recap_fa48a58c:
    stella "«Я понятия не имела, сколько ты ещё будешь без сознания. Нужно было идти за помощью»."

# unit d:tuesday_keen_kaneeka_rosalina_recap_229f0043
translate russian tuesday_keen_kaneeka_rosalina_recap_229f0043:
    kaneeka "«Эй... по крайней мере, ты в живых, верно?»"

# unit d:tuesday_keen_kaneeka_rosalina_recap_ditchlings_00d0a68f
translate russian tuesday_keen_kaneeka_rosalina_recap_ditchlings_00d0a68f:
