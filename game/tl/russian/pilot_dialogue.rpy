# unit d:tuesday_tabitha_present_rosa_hurt_3_join_c84e28d4
translate russian tuesday_tabitha_present_rosa_hurt_3_join_c84e28d4:
    tabitha "«Как видишь, приходится»."

# unit d:tuesday_tabitha_present_rosa_hurt_3_join_36f75c99
translate russian tuesday_tabitha_present_rosa_hurt_3_join_36f75c99:
    tabitha "«Пожалуйста, перестань пытаться угробить мою двоюродную родню, Стелла»."

# unit d:tuesday_tabitha_present_rosa_hurt_3_join_b80d22c4
translate russian tuesday_tabitha_present_rosa_hurt_3_join_b80d22c4:
    tabitha "«Ну же, пойдём»."

# unit d:tuesday_tabitha_present_rosa_hurt_3_join_597dfe39
