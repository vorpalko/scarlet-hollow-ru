    gretchen "«Удачи, [player_name]»."

# unit d:monday_stella_recap_c635b9a8
translate russian monday_stella_recap_c635b9a8:
    "{i}Вы ничего не отвечаете.{/i}"

# unit d:monday_stella_recap_9c510f8f_3
