# unit d:wednesday_tabitha_left_outside_housing_643c49dd
translate russian wednesday_tabitha_left_outside_housing_643c49dd:
    p "«Есть идеи, Табита?»"

# unit d:wednesday_tabitha_left_outside_housing_234dee62
translate russian wednesday_tabitha_left_outside_housing_234dee62:
