    p "«Мы {b}{i}могли бы{/i}{/b} просто все уйти... Что самое страшное может случиться?»"

# unit d:tuesday_mines_depths_tabitha_keen_embark_convo_4363458b
translate russian tuesday_mines_depths_tabitha_keen_embark_convo_4363458b:
