# unit d:wednesday_trial_tabitha_eddie_murderer_33d049ae
translate russian wednesday_trial_tabitha_eddie_murderer_33d049ae:
    p "«С чего бы? Я ни за что из этого не отвечаю»."

# unit d:wednesday_trial_tabitha_eddie_murderer_e2940984
