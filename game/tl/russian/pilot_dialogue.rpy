# unit d:wednesday_library_group_keen_eye_2e66f47b
translate russian wednesday_library_group_keen_eye_2e66f47b:
    stella "«Ещё как!»"

# unit d:wednesday_library_group_keen_eye_2e66f47b_1
translate russian wednesday_library_group_keen_eye_2e66f47b_1:
    stella "«Ещё как!»"

# unit d:wednesday_library_group_keen_eye_b3be29f4
translate russian wednesday_library_group_keen_eye_b3be29f4:
    kaneeka "«Если аниме меня чему и научило, так это тому, что Сила Дружбы {b}{i}и правда{/i}{/b} непобедима»."

# unit d:wednesday_library_group_keen_eye_315ea3f4
translate russian wednesday_library_group_keen_eye_315ea3f4:
    oscar "«Очень приятные слова. Уверен, Розалине будет хотя бы приятно знать, что вы сделали всё, что могли, чтобы ей помочь»."

# unit d:wednesday_library_group_keen_eye_4bdfb3ae
translate russian wednesday_library_group_keen_eye_4bdfb3ae:
    p "«Я всё ещё не верю в призраков»."

# unit d:wednesday_library_group_keen_eye_dd85a393
