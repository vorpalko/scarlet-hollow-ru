# unit d:wednesday_tabitha_leaving_chat_e19228a5
translate russian wednesday_tabitha_leaving_chat_e19228a5:
    p "«„Отнять ступню“? Господи, Табита. Ты выражений не выбираешь»."

# unit d:wednesday_tabitha_leaving_chat_a4aaa9d3
translate russian wednesday_tabitha_leaving_chat_a4aaa9d3:
    tabitha "«А что, мне всё приукрасить? Сказать „к сожалению, ногу спасти не удалось“?»"

