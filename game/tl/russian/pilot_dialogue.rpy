# unit d:friday_panic_stellamance_action_menu_e0dd3275
translate russian friday_panic_stellamance_action_menu_e0dd3275:
    stella "«Но это неважно. Главное — поговорить с ней. Всё остальное {b}{i}неважно{/i}{/b}»."

# unit d:friday_panic_stellamance_action_menu_4ac100d0
translate russian friday_panic_stellamance_action_menu_4ac100d0:
