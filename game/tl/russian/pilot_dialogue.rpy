# unit d:friday_kaneeka_tabitha_anti_sybil_tea_join_ab5f5354
translate russian friday_kaneeka_tabitha_anti_sybil_tea_join_ab5f5354:
    sybil "«И называть лечение этого юноши ядом...»"

# unit d:friday_kaneeka_tabitha_anti_sybil_tea_join_28a90d90
