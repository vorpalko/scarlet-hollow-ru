# unit d:tuesday_mines_escape_becka_kaneeka_running_82e0019c
translate russian tuesday_mines_escape_becka_kaneeka_running_82e0019c:
    "{i}Всё вокруг сотрясается: шахта обрушивается прямо вокруг вас.{/i}"

# unit d:tuesday_mines_escape_becka_kaneeka_running_26cb89a6
translate russian tuesday_mines_escape_becka_kaneeka_running_26cb89a6:
    "{i}А потом стук стихает, и вы чувствуете себя в безопасности: до входа удалось добраться в целости и сохранности.{/i}"

# unit d:tuesday_mines_escape_becka_kaneeka_running_40ccfbb9
translate russian tuesday_mines_escape_becka_kaneeka_running_40ccfbb9:
    becka "«К-какого хуя... какого {b}{i}хуя?!{/i}{/b}»"

# unit d:tuesday_mines_escape_becka_kaneeka_running_79b75b5f
translate russian tuesday_mines_escape_becka_kaneeka_running_79b75b5f:
    alexis "«Розалина! Ты в порядке?»"

# unit d:tuesday_mines_escape_becka_kaneeka_running_5f23249a
translate russian tuesday_mines_escape_becka_kaneeka_running_5f23249a:
    becka "«{b}{i}Ясно же{/i}{/b}, что не в порядке, идиотка!»"

# unit d:tuesday_mines_escape_becka_kaneeka_running_84d43cb1
translate russian tuesday_mines_escape_becka_kaneeka_running_84d43cb1:
    alexis "«{b}{i}Заткнись,{/i}{/b} Бекка! Это вообще {b}{i}ты{/i}{/b} придумала сюда спуститься! Это {b}{i}твоя вина{/i}{/b}»."

# unit d:tuesday_mines_escape_becka_kaneeka_running_9dc39ccb
translate russian tuesday_mines_escape_becka_kaneeka_running_9dc39ccb:
    rosalina "«{b}{i}Кхе...{/i}{/b}»"

# unit d:tuesday_mines_escape_becka_kaneeka_running_cd4ee0cc
translate russian tuesday_mines_escape_becka_kaneeka_running_cd4ee0cc:
    rosalina "«Очень... больно...»"

# unit d:tuesday_mines_escape_becka_kaneeka_running_0f5c3340
translate russian tuesday_mines_escape_becka_kaneeka_running_0f5c3340:
    "{i}Во вход в шахту заглядывают Стелла и Каника.{/i}"

# unit d:tuesday_mines_escape_becka_kaneeka_running_62ffbe64
translate russian tuesday_mines_escape_becka_kaneeka_running_62ffbe64:
    stella "«Кажется, я слышу там голоса...»"

# unit d:tuesday_mines_escape_becka_kaneeka_running_c76a7f06
translate russian tuesday_mines_escape_becka_kaneeka_running_c76a7f06:
