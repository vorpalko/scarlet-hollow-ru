    dustin "«Нет, это Дастин дом»."

# unit d:general_opossum_convo_6699027d
translate russian general_opossum_convo_6699027d:
    p "«Можешь рассказать мне про человека, который здесь живёт?»"

# unit d:general_opossum_convo_0767e039
