# unit d:wednesday_library_group_save_becka_a8c2dc00
translate russian wednesday_library_group_save_becka_a8c2dc00:
    kaneeka "«Мы точно хотим заняться этим после захода солнца...?»"

# unit d:wednesday_library_group_save_becka_5ea9570b
translate russian wednesday_library_group_save_becka_5ea9570b:
    kaneeka "«Почему бы не пойти прямо сейчас, пока светло и меньше шансов, что я струшу?»"

# unit d:wednesday_library_group_save_becka_4e6eb9dc
translate russian wednesday_library_group_save_becka_4e6eb9dc:
    oscar "«Не знаю даже, увидим ли мы хоть что-нибудь, не говоря уже о том, сможем ли „поймать призрака“»."

# unit d:wednesday_library_group_save_becka_2121dd49
translate russian wednesday_library_group_save_becka_2121dd49:
    avery "«Все знают, что призраки активны только ночью. Чтобы было как можно страшнее»."

# unit d:wednesday_library_group_save_becka_0f7a0872
translate russian wednesday_library_group_save_becka_0f7a0872:
