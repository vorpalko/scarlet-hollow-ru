translate russian tuesday_town_tabitha_sybil_8279e51e_3:
    avery "«Но я не настаиваю»."

# unit d:tuesday_tabitha_town_avery_leaves_5a4d33b2
translate russian tuesday_tabitha_town_avery_leaves_5a4d33b2:
    avery "«В общем, решать тебе. Ещё увидимся, [player_name]. Пока, Сибил»."

# unit d:tuesday_tabitha_town_avery_leaves_9e94af5f
translate russian tuesday_tabitha_town_avery_leaves_9e94af5f:
    avery "«Пока»."

# unit d:tuesday_tabitha_town_avery_leaves_89aa0263
translate russian tuesday_tabitha_town_avery_leaves_89aa0263:
    sybil "«Береги себя, Эйвери»."

# unit d:tuesday_tabitha_town_avery_leaves_90a4ea36
translate russian tuesday_tabitha_town_avery_leaves_90a4ea36:
    sybil "«Вижу, ты предпочитаешь держать личное при себе. Уважаю»."

# unit d:tuesday_tabitha_town_avery_leaves_fd0d9f24
translate russian tuesday_tabitha_town_avery_leaves_fd0d9f24:
    sybil "«Никогда не знаешь, как человек отреагирует на правду о том, с чем вы столкнулись прошлой ночью»."

# unit d:tuesday_tabitha_town_avery_leaves_41da3e2e
translate russian tuesday_tabitha_town_avery_leaves_41da3e2e:
    sybil "«Мне тоже пора вернуться к делам»."

# unit d:tuesday_tabitha_town_avery_leaves_be56272d
translate russian tuesday_tabitha_town_avery_leaves_be56272d:
    sybil "«Рада, что удалось тебя застать сегодня утром, хотя бы узнать, как ты держишься»."

# unit d:tuesday_tabitha_town_avery_leaves_61ffbdc2
translate russian tuesday_tabitha_town_avery_leaves_61ffbdc2:
    sybil "«Пожалуйста, заходи, если я могу чем-то помочь»."

# unit d:tuesday_tabitha_town_avery_leaves_ee8c93bb
translate russian tuesday_tabitha_town_avery_leaves_ee8c93bb:
    p "«Эй, послушайте, не люблю, когда меня водят за нос! Прошлой ночью вы говорили о великой беде у нас на пороге, а теперь у вас ни один мускул не дрогнет. В чём дело? Что-то здесь не сходится»."

# unit d:tuesday_tabitha_town_avery_leaves_513e30bf
translate russian tuesday_tabitha_town_avery_leaves_513e30bf:
    sybil "«Не принимай моё спокойствие за беспечность. У каждого из нас своя роль»."

# unit d:tuesday_tabitha_town_avery_leaves_23d53cc5
translate russian tuesday_tabitha_town_avery_leaves_23d53cc5:
    sybil "«Я поделилась тем, что знаю о канавниках, и верю, что тебе, Стелле и Канике по силам во всём разобраться»."

# unit d:tuesday_tabitha_town_avery_leaves_04693344
translate russian tuesday_tabitha_town_avery_leaves_04693344:
    sybil "«Мне очень жаль прерывать наш разговор, но меня ждут дела»."

# unit d:tuesday_tabitha_town_avery_leaves_0b362ebb
translate russian tuesday_tabitha_town_avery_leaves_0b362ebb:
    sybil "«Береги себя, [player_name], и храни тебя Бог»."

# unit d:tuesday_tabitha_town_avery_leaves_bc01ff33
translate russian tuesday_tabitha_town_avery_leaves_bc01ff33:
    p "«Послушайте, меня не проведёшь. Подобной ауры мне ещё не доводилось видеть. Честно, вы ведьма?»"

# unit d:tuesday_tabitha_town_avery_leaves_3484e6a2
translate russian tuesday_tabitha_town_avery_leaves_3484e6a2:
    sybil "«Мне льстит такой вопрос, но на самом деле я просто старушка, научившаяся слушать, когда мир раскрывает мне свои тайны»."

# unit d:tuesday_tabitha_town_avery_leaves_925ff88c
translate russian tuesday_tabitha_town_avery_leaves_925ff88c:
    sybil "«Будь то свойства какого-нибудь листа или гриба или же всякая ночная нечисть»."

# unit d:tuesday_tabitha_town_avery_leaves_04693344_1
translate russian tuesday_tabitha_town_avery_leaves_04693344_1:
    sybil "«Мне очень жаль прерывать наш разговор, но меня ждут дела»."

