# unit d:wednesday_trial_tabitha_eddie_murderer_1423e815
translate russian wednesday_trial_tabitha_eddie_murderer_1423e815:
    avery "«Пока вы этого не сделаете, я не могу умереть»."

# unit d:wednesday_trial_tabitha_eddie_murderer_3f7e343c
translate russian wednesday_trial_tabitha_eddie_murderer_3f7e343c:
    zane "«Пока вы этого не сделаете, я не могу умереть»."

# unit d:wednesday_trial_tabitha_eddie_murderer_97297128
translate russian wednesday_trial_tabitha_eddie_murderer_97297128:
    rosalina "«Я хочу умереть. Пожалуйста. Я был один в темноте. Так долго»."

# unit d:wednesday_trial_tabitha_eddie_murderer_ef16267c
translate russian wednesday_trial_tabitha_eddie_murderer_ef16267c:
    kaneeka "«Я прошу лишь часть ваших лет...»"

# unit d:wednesday_trial_tabitha_eddie_murderer_c2d3a1ad
translate russian wednesday_trial_tabitha_eddie_murderer_c2d3a1ad:
