# unit d:thursday_maxwell_carvings_doctor_join_8ddb7d76
translate russian thursday_maxwell_carvings_doctor_join_8ddb7d76:
    kaneeka "«Что такое? Всё в порядке?»"

# unit d:thursday_maxwell_carvings_doctor_join_58ee3fe0
