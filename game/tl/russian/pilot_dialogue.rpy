# unit d:monday_duke_mystical_join_151db7f5_2
translate russian monday_duke_mystical_join_151db7f5_2:
    duke "«А теперь бегом домой и не ищите приключений»."

# unit d:monday_duke_mystical_join_3151e951
translate russian monday_duke_mystical_join_3151e951:
    p "«Спроси позже»."

# unit d:monday_duke_mystical_join_2962335c
