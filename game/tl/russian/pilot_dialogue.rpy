# unit d:friday_kaneeka_tabitha_sacrifice_unfair_menu_cbbdec33
translate russian friday_kaneeka_tabitha_sacrifice_unfair_menu_cbbdec33:
    kaneeka "«У меня есть шанс изменить будущее. Почти никому не дано знать, что он изменит так много»."

# unit d:friday_kaneeka_tabitha_sacrifice_unfair_menu_fd25106d
translate russian friday_kaneeka_tabitha_sacrifice_unfair_menu_fd25106d:
