    kaneeka "«Д-да. Увидимся»."

# unit d:monday_general_store_forgot_pay_fcb825ed
translate russian monday_general_store_forgot_pay_fcb825ed:
    "{i}Договор скреплён. Чипсы теперь ваши.{/i}"

# unit d:monday_general_store_forgot_pay_66685525
