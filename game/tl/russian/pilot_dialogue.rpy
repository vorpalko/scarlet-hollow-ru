    kaneeka "«О боже...»"

# unit d:tuesday_mines_escape_rosalina_kaneeka_76219140_1
translate russian tuesday_mines_escape_rosalina_kaneeka_76219140_1:
    rosalina "«Простите меня»."

# unit d:tuesday_mines_escape_rosalina_kaneeka_d79bcfca
translate russian tuesday_mines_escape_rosalina_kaneeka_d79bcfca:
    kaneeka "«Розалина, ты в порядке? Твой папа уже едет. Должен быть здесь с минуты на минуту»."

# unit d:tuesday_mines_escape_rosalina_kaneeka_0237b2ff
