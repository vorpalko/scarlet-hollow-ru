    stella "«Э-э... спасибо?»"

# unit d:tuesday_tabitha_present_rosa_hurt_1_join_e67b7ffe
translate russian tuesday_tabitha_present_rosa_hurt_1_join_e67b7ffe:
    tabitha "«[player_name], у тебя ведь есть её номер? Держи меня в курсе, чем она занимается. Сообщи, если эта „охота на призраков“ действительно состоится»."

# unit d:tuesday_tabitha_present_rosa_hurt_1_join_480e86dd
