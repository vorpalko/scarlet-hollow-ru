    tabitha "«...»"

# unit d:keen_kaneeka_becka_convince_35254753
translate russian keen_kaneeka_becka_convince_35254753:
    p "«Все остыньте. Давайте не позволять эмоциям брать верх»."

# unit d:keen_kaneeka_becka_convince_37295024
translate russian keen_kaneeka_becka_convince_37295024:
    kaneeka "«Не позволять эмоциям брать верх?!»"

# unit d:keen_kaneeka_becka_convince_29f18792
