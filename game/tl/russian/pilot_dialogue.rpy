# unit d:wednesday_stella_hangout_wayne_join_34730f9e
translate russian wednesday_stella_hangout_wayne_join_34730f9e:
    stella "«Лучше об этом не думать!»"

# unit d:wednesday_stella_hangout_wayne_join_6cb1eca0
translate russian wednesday_stella_hangout_wayne_join_6cb1eca0:
    p "«Ничего полезного он толком не рассказал. Просто хотелось, чтобы ты знала о нашем разговоре»."

# unit d:wednesday_stella_hangout_wayne_join_ef469a1e
translate russian wednesday_stella_hangout_wayne_join_ef469a1e:
