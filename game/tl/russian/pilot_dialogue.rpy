    tabitha "«Я тоже»."

# unit d:wednesday_trial_tabitha_eddie_murderer_47ca8612
translate russian wednesday_trial_tabitha_eddie_murderer_47ca8612:
    p "«Да»."

# unit d:wednesday_trial_tabitha_eddie_murderer_a8bf60fe
translate russian wednesday_trial_tabitha_eddie_murderer_a8bf60fe:
    tabitha "«Что?! Не отвечай ему!»"

# unit d:wednesday_trial_tabitha_eddie_murderer_0c32913e
translate russian wednesday_trial_tabitha_eddie_murderer_0c32913e:
    p "«Нет»."

# unit d:wednesday_trial_tabitha_eddie_murderer_bc8651ae
translate russian wednesday_trial_tabitha_eddie_murderer_bc8651ae:
    tabitha "«Я ценю твои намерения, но не разговаривай с ним»."

# unit d:wednesday_trial_tabitha_eddie_murderer_6c8b6589
translate russian wednesday_trial_tabitha_eddie_murderer_6c8b6589:
    p "«Мне жаль, что ты умер»."

# unit d:wednesday_trial_tabitha_eddie_murderer_87f9b342_1
translate russian wednesday_trial_tabitha_eddie_murderer_87f9b342_1:
    tabitha "«Не отвечай ему!»"

# unit d:wednesday_trial_tabitha_eddie_murderer_4a4bfce8
