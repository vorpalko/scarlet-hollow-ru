# unit d:tuesday_mines_depths_tabitha_embark_convo_4c40832d
translate russian tuesday_mines_depths_tabitha_embark_convo_4c40832d:
    alexis "«{i}Б... Бекка, а зачем мы это делаем? Мне казалось, ты считала Табиту типа очень крутой. Зачем ты пытаешься её разозлить?{/i}»"

# unit d:tuesday_mines_depths_tabitha_embark_convo_bbda3227
translate russian tuesday_mines_depths_tabitha_embark_convo_bbda3227:
    becka "«{i}Эм, мы это делаем {b}потому{/b}, что Табита очень крутая. Она никому не позволяет собой командовать, так что мы не можем просто позволить ей командовать {b}нами{/b}».{/i}"

# unit d:tuesday_mines_depths_tabitha_embark_convo_d69ed949
translate russian tuesday_mines_depths_tabitha_embark_convo_d69ed949:
